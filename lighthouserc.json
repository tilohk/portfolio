{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3200",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/projects",
        "http://localhost:3200/projects/wall-thickness-control",
        "http://localhost:3200/journal",
        "http://localhost:3200/resume",
        "http://localhost:3200/contact"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-report" }
  }
}
