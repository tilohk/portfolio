# Copy to .env.local and fill in. Never commit real values.

# Resend (https://resend.com) API key used by the contact form.
RESEND_API_KEY=
# Where contact messages are delivered.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend. For testing: "Portfolio <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=
